{
  "uid": "mynotion-overview",
  "title": "MyNotion Overview",
  "description": "API 처리량·응답 시간·오류 비율과 DB 커넥션 풀·JVM 힙을 확인한다.",
  "tags": ["mynotion", "spring-boot"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "요청 처리량 (RPS)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {
        "defaults": {"unit": "reqps", "min": 0},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"mynotion-backend\", uri!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": "초당 요청 수",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "title": "p95 응답 시간",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {
        "defaults": {"unit": "s", "min": 0},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"mynotion-backend\", uri!~\"/actuator.*\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "title": "p99 응답 시간",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "fieldConfig": {
        "defaults": {"unit": "s", "min": 0},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"mynotion-backend\", uri!~\"/actuator.*\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "title": "5xx 에러 비율",
      "description": "5xx가 없으면 0%, 트래픽이 없으면 빈 값",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "fieldConfig": {
        "defaults": {"unit": "percentunit", "min": 0},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "(sum(rate(http_server_requests_seconds_count{application=\"mynotion-backend\", uri!~\"/actuator.*\", status=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(http_server_requests_seconds_count{application=\"mynotion-backend\", uri!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": "5xx 비율",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "title": "HikariCP 커넥션",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "fieldConfig": {
        "defaults": {"unit": "short", "min": 0, "decimals": 0},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "hikaricp_connections_active{application=\"mynotion-backend\"}",
          "legendFormat": "활성 {{pool}}",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "hikaricp_connections_max{application=\"mynotion-backend\"}",
          "legendFormat": "최대 {{pool}}",
          "range": true
        },
        {
          "refId": "C",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "hikaricp_connections_pending{application=\"mynotion-backend\"}",
          "legendFormat": "대기 {{pool}}",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "title": "JVM 힙 사용량",
      "description": "최대 힙은 제한 없음(-1)인 메모리 풀을 제외하고 합산한다.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "fieldConfig": {
        "defaults": {"unit": "bytes", "min": 0},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(jvm_memory_used_bytes{application=\"mynotion-backend\", area=\"heap\"})",
          "legendFormat": "사용량",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(jvm_memory_max_bytes{application=\"mynotion-backend\", area=\"heap\"} > 0)",
          "legendFormat": "최대 용량",
          "range": true
        }
      ]
    }
  ]
}
